# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Better Auth 认证
BETTER_AUTH_SECRET=your-secret-key-here
# 外部访问 URL（客户端和 CORS 使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 是否在侧边栏显示 AI 对话/AI 生图/文件上传（默认隐藏）
NEXT_PUBLIC_ENABLE_AI_SIDEBAR=false
# 可选：额外的受信任来源（逗号分隔）
TRUSTED_ORIGINS=

# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info

# AI 接口（OpenAI 兼容）
# 推荐使用 302.ai ，基本涵盖了市面上的常用 AI 模型
# AI_API_ENDPOINT=https://api.302.ai
AI_API_ENDPOINT=https://api.openai.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=gpt-4o-mini

# Gemini 图片生成接口（302.ai Nano Banana Pro）
# 如果使用 302.ai，推荐使用以下配置
GEMINI_IMAGE_API_ENDPOINT=https://api.302.ai
GEMINI_IMAGE_API_KEY=sk-xxx

# S3 兼容存储（可选，如 Sealos、MinIO、阿里云 OSS）
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_DOMAIN=

# 腾讯云短信服务
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# 开发环境是否发送真实短信（仅 NODE_ENV != production 时生效）
# false: 仅在服务端 console 打印 OTP；true: 真实发送短信
DEV_SEND_SMS=false

# Mails
PLUNK_API_KEY=sk
