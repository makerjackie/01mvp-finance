# Normalize all text files to LF on checkout
* text=auto eol=lf

# Common extensions we want to stay on LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.sh text eol=lf
Makefile text eol=lf
