generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 用户模型
model User {
  id                  String         @id @map("_id")
  name                String
  username            String?        @unique
  displayUsername     String?
  email               String         @unique
  phoneNumber         String?        @unique
  phoneNumberVerified Boolean        @default(false)
  emailVerified       Boolean
  image               String?
  role                String?        @default("user") // "admin" | "user"
  banned              Boolean?       @default(false)
  banReason           String?
  banExpires          DateTime?
  twoFactorEnabled    Boolean        @default(false)
  createdAt           DateTime
  updatedAt           DateTime
  sessions            Session[]
  accounts            Account[]
  chatMessages        ChatMessage[]   @relation("UserChatMessages")
  chatSessions        ChatSession[]   @relation("UserChatSessions")
  twoFactor           TwoFactor?
  memberships         Member[]
  invitations         Invitation[]   @relation("InvitationInviter")
  financeRecords      FinanceRecord[] @relation("UserFinanceRecords")

  @@map("user")
}

// 会话
model Session {
  id           String   @id @map("_id")
  expiresAt    DateTime
  token        String   @unique
  createdAt    DateTime
  updatedAt    DateTime
  ipAddress    String?
  userAgent    String?
  impersonatedBy String?
  activeOrganizationId String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// OAuth 账户
model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

// 验证码
model Verification {
  id         String    @id @map("_id")
  identifier String    // 手机号或邮箱
  value      String    // 验证码
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model TwoFactor {
  id          String @id @default(cuid()) @map("_id")
  secret      String
  backupCodes String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id          String        @id @default(cuid()) @map("_id")
  name        String
  slug        String        @unique
  logo        String?
  createdAt   DateTime      @default(now())
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid()) @map("_id")
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid()) @map("_id")
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// 聊天消息
model ChatMessage {
  id         String       @id @default(cuid()) @map("_id")
  sessionId  String
  session    ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation("UserChatMessages", fields: [userId], references: [id], onDelete: SetNull)
  role       String       // "user" | "assistant" | "system"
  parts      Json?
  content    String
  clientId   String?      @unique
  createdAt  DateTime     @default(now())

  @@index([sessionId])
  @@index([userId])
  @@map("chat_message")
}

model ChatSession {
  id        String         @id @default(cuid()) @map("_id")
  title     String?
  userId    String?
  user      User?          @relation("UserChatSessions", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_session")
}

// 应用配置（全局仅一条）
model AppConfig {
  id                   String   @id @default("global")
  passwordLoginEnabled Boolean  @default(false)
  smsLoginEnabled      Boolean  @default(true)
  perUserDailyQuota    Int      @default(1000)
  globalDailyQuota     Int      @default(100000)
  perUserRateLimit     Int      @default(60)
  globalRateLimit      Int      @default(1200)
  maintenanceMode      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedById          String?

  @@map("app_config")
}

model FeatureFlag {
  id                String   @id @default(cuid()) @map("_id")
  key               String   @unique
  name              String
  description       String?
  status            String   @default("off") // "on" | "off" | "rollout"
  rolloutPercentage Int      @default(0)
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?
  updatedById       String?

  @@map("feature_flag")
}

// 财务记录表 - 统一存储所有类型的财务申请
model FinanceRecord {
  id              String   @id @default(cuid()) @map("_id")
  userId          String
  user            User     @relation("UserFinanceRecords", fields: [userId], references: [id], onDelete: Cascade)

  // 记录类型：income(收入) | expense(支出)
  type            String

  // 类别
  category        String                   // 收入类别或支出类别
  subcategory     String?                  // 子类别（如：入门活动、进阶活动等）

  // 通用字段
  amount          Float                    // 金额
  relatedProject  String?                  // 关联项目/活动名称
  description     String                   // 详细说明/事由
  attachments     String[]  @default([])   // 附件URL数组

  // 收款/付款信息
  recipientName   String?                  // 收款人/供应商姓名（对方户名）
  recipientAccount String?                 // 收款账号/供应商账号（对方账号）
  recipientBank   String?                  // 收款人开户行（对方开户行）
  recipientIdCard String?                  // 收款人身份证（劳务类需要）

  // 银行流水相关
  transactionNo   String?                  // 流水号
  transactionDate DateTime?                // 交易日期
  summary         String?                  // 摘要
  purpose         String?                  // 用途

  // 支付相关
  paymentStatus   String   @default("unpaid") // unpaid(未支付) | paid(已支付)
  paymentDate     DateTime?                // 实际支付日期
  paidBy          String?                  // 出纳/支付人ID
  accountPeriod   String?                  // 账期（例如：2025-01）

  // 税务相关
  taxHandling     String?                  // 个人所得税处理方式：withhold(代扣代缴) | self(自行申报) | none(无需处理)

  // 账目类型：是否为社区公开账目
  isCommunity     Boolean  @default(true)  // true=社区账目（公开）, false=公司内部账目（仅管理员可见）

  // 审批状态
  status          String   @default("pending") // pending(待审核) | approved(已通过) | rejected(已拒绝)
  reviewNote      String?                  // 审批备注
  reviewedAt      DateTime?                // 审批时间
  reviewedBy      String?                  // 审批人ID

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([isCommunity])
  @@map("finance_record")
}
