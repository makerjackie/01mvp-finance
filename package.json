{
  "name": "01mvp-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.38",
  "scripts": {
    "postinstall": "bun run db:generate && simple-git-hooks",
    "dev": "next dev --turbopack",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "bun x biome format --write .",
    "format:staged": "bash scripts/pre-commit.sh",
    "format:check": "bun x biome check --formatter-enabled=true --linter-enabled=false .",
    "build": "next build",
    "start": "next start",
    "cf:build": "bun x next-on-pages",
    "cf:preview": "bun run cf:build && bun x wrangler pages dev .vercel/output/static",
    "cf:deploy": "bun run cf:build && bun x wrangler pages deploy .vercel/output/static",
    "db:generate": "dotenv -c -- prisma generate --schema src/server/prisma/schema.prisma",
    "db:push": "dotenv -c -- prisma db push --schema=src/server/prisma/schema.prisma",
    "db:studio": "dotenv -c -- prisma studio --config prisma.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.10",
    "prisma": "^7.0.1",
    "simple-git-hooks": "^2.10.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "wrangler": "^4.51.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/react": "^1.0.0",
    "@aws-sdk/client-s3": "^3.744.0",
    "@better-fetch/fetch": "^1.1.18",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "^4.0.0",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "framer-motion": "^12.23.24",
    "hono": "^4.10.6",
    "lucide-react": "^0.477.0",
    "nanoid": "^3.3.11",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "streamdown": "^1.6.9",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tencentcloud-sdk-nodejs": "^4.1.147"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/pre-commit.sh"
  }
}
